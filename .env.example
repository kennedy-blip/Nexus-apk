# ---------------------------------------------------------------------------
# NexusAPK Studio — environment template
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (control plane: auth, metadata, storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only. Either form works and both grant full access:
#   SUPABASE_SERVICE_ROLE_KEY — legacy service_role JWT (eyJhbGci…)
#   SUPABASE_SECRET_KEY       — newer secret key (sb_secret_…)
# Route handlers need ONE of them for the reaper, account deletion and the
# health probe. Without it those paths degrade loudly rather than using anon.
# Generate in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# SUPABASE_SECRET_KEY=sb_secret_yyy

# Public site origin — canonical URLs, OAuth redirects, OpenGraph.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI orchestrator (server-only, never exposed to the browser)
NEXUS_BACKEND_URL=http://100.64.0.1:8000
NEXUS_BACKEND_TOKEN=change-me-shared-hmac-token

# Session policy
# Leave unset (or 0) for unlimited signed-in sessions. Set a positive number of
# seconds only to impose a hard capacity cap on cloud devices.
# NEXUS_SESSION_TTL_SECONDS=
# Abandoned-container grace for a lease-free session (real containers only).
NEXUS_IDLE_TIMEOUT_SECONDS=1800
NEXUS_MAX_UPLOAD_BYTES=536870912

# Storage bucket that holds APK binaries
NEXUS_APK_BUCKET=apks

# Streaming: leave empty to route frames through the same-origin proxy
# (/api/stream/*), which keeps the orchestrator on the private network.
# NEXUS_STREAM_PUBLIC_URL=https://orchestrator.example.com
NEXUS_STREAM_FPS=8
