# ---------------------------------------------------------------------------
# NexusScope — environment template
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (auth + inspection history)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only privileged key. Either form works and both grant full access:
#   SUPABASE_SERVICE_ROLE_KEY — legacy service_role JWT (eyJhbGci…)
#   SUPABASE_SECRET_KEY       — newer secret key (sb_secret_…)
# Used by the health probe (a real database query) and by account deletion.
# Without it those two paths degrade loudly rather than quietly using anon.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# SUPABASE_SECRET_KEY=sb_secret_yyy

# Public site origin — canonical URLs, OAuth redirects, OpenGraph metadata.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# There is deliberately no inspector tuning block here.
#
# Limits live in code so they cannot be widened by an environment mistake:
#   - anonymous allowance   app/api/inspect/route.ts  (5 per 10 minutes)
#   - batch size            lib/inspect/batch.ts      (20 URLs)
#   - body ceiling          lib/inspect/fetch.ts      (3 MB decompressed)
#   - request/redirect caps lib/inspect/fetch.ts
#
# No Google/Cloudflare/analytics keys are needed: the inspector uses only
# node:dns, node:tls and node:http.
# ---------------------------------------------------------------------------
