# ---------------------------------------------------------------------------
# NexusAPK Studio — environment template
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (control plane: auth, metadata, storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only. Used by route handlers for signed URLs / privileged writes.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Public site origin (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI orchestrator (server-only, never exposed to the browser)
NEXUS_BACKEND_URL=http://100.64.0.1:8000
NEXUS_BACKEND_TOKEN=change-me-shared-hmac-token

# Session policy
NEXUS_SESSION_TTL_SECONDS=900
NEXUS_IDLE_TIMEOUT_SECONDS=900
NEXUS_MAX_UPLOAD_BYTES=536870912

# Storage bucket that holds APK binaries
NEXUS_APK_BUCKET=apks
