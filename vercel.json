{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/reap",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "app/api/stream/[id]/frames/route.ts": {
      "maxDuration": 300
    },
    "app/api/session/start/route.ts": {
      "maxDuration": 60
    },
    "app/api/apks/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/reap/route.ts": {
      "maxDuration": 60
    }
  }
}
